# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local tooling caches
.eslintcache
.turbo

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# TypeScript and generated framework files
*.tsbuildinfo
next-env.d.ts

# Prisma generated client is recreated by `prisma generate`.
/src/generated/prisma/
progres.txt

# AI assistant / agent tooling (local only)
/.agents/
/.claude/
/.windsurf/
/.opencode/
/skills-lock.json

# python cache
__pycache__/
*.pyc

# local design references (not part of the app)
/design-references/
